;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gunstar Heroes Remake"
config/description="Best Juego Islas Tiki Tiki"
run/main_scene="uid://hd68cutw7xyg"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://drgl8c1lsrpba"

[audio]

buses/default_bus_layout="res://Resources/default_bus_layout.tres"

[autoload]

BulletPool="*uid://dxij5w0q5ifim"
GameEvents="*uid://baay76cbjy0em"
AudioManager="*uid://cxh46sm6t23gg"
